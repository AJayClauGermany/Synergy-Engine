# Every environment variable this project reads, in one place. Committed on purpose: it
# lists names, types and which values are secret, and never holds a secret itself.
# Values go in `.env.local` (git-ignored); `bun run backend` writes the Convex ones for you.
#
# Managed by varlock (https://varlock.dev). The scripts in package.json run through
# `varlock run --`, so these are validated and injected for you. Useful commands:
#   bunx varlock load      check the configuration (secrets are masked)
#   bunx varlock reveal    show a secret to yourself
#   bunx varlock scan      look for secrets that leaked into files
#
# Nothing here is required: with no values at all the game runs single-player and
# peer-to-peer. Each section says what a value turns on.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# ---- Convex: the lobby (room list, join codes, player names) ----------------------------
# One-time setup:   bun run backend     (log in once; it creates a deployment and writes
#                                        CONVEX_DEPLOYMENT and CONVEX_URL to .env.local)
# After that there is nothing to copy: PUBLIC_CONVEX_URL below picks CONVEX_URL up.

# Which Convex deployment the `convex` CLI talks to. Written by `bun run backend`.
CONVEX_DEPLOYMENT=

# Address of your Convex deployment, e.g. https://happy-animal-123.convex.cloud.
# Written by `bun run backend`.
# @type=url
CONVEX_URL=

# The same address as the browser sees it. Only PUBLIC_ variables are built into the page,
# so never put a secret in one. Set it yourself to point a build at another deployment;
# in CI it is a repository variable holding the production address (docs/setup.md).
# @type=url
PUBLIC_CONVEX_URL=${CONVEX_URL}

# Lets CI or a script deploy the Convex functions without logging in (`bunx convex deploy`).
# Create one in the Convex dashboard under Settings, Deploy keys.
# @sensitive
CONVEX_DEPLOY_KEY=

# ---- Build ---------------------------------------------------------------------------------

# Identifies a build of the game (`buildId` in game/src/env.ts). Leave it empty: the build
# sets it to a hash of the source. Players on different builds cannot join each other, so
# set it yourself only to use your own release numbers.
PUBLIC_BUILD_ID=

# ---- Dev server ----------------------------------------------------------------------------

# Port for `bun run dev` (default 3000) and `bun run start` (default 4173).
# @type=port
PORT=

# ---- Cloudflare: private previews (see docs/deploying.md) ----------------------------------

# What wrangler needs to deploy without an interactive login, such as in CI. With both set,
# `bun run preview:deploy` and `bun run deploy` also keep the assets in R2 and set up
# Cloudflare Access. The token needs: Workers Scripts: Edit, Workers R2 Storage: Edit,
# Access: Apps and Policies: Edit (docs/setup.md, step 5A, says how to create it).
# `bun run cloudflare:check` tells you whether the account is ready, without changing it.
# @sensitive
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Who may open a preview: email addresses, and whole domains written as @studio.com,
# separated by commas, spaces or new lines. Each deploy makes Cloudflare Access admit exactly
# these (its free plan covers 50 people). In CI this is a repository variable of the same
# name (a variable, not a secret). Empty means no Access, and a locked deployment.
PREVIEW_ALLOWED_EMAILS=

# Optional fallback gate: one shared password, asked for only by a deployment that has no
# Cloudflare Access in front (PREVIEW_ALLOWED_EMAILS empty, or no API token). Access comes
# first whenever both are set. A deploy stores it as a secret of the Worker. In CI this is
# a repository secret of the same name. Use a long random one.
# @sensitive
PREVIEW_PASSWORD=
