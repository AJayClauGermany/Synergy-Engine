{
  // The Electrobun SDK types live in .hutch/devkit, which Hutch generates the first time
  // you run `bun run desktop:dev` or `desktop:build`. Until then this project cannot be
  // type-checked, which is why the root `bun run typecheck` leaves it out.
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "electrobun.config.ts"],
  "exclude": ["dist", "build", "artifacts"]
}
