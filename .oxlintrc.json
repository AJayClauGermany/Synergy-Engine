// Per-file lint (`bun run lint`). Rules are errors or off: a warning nobody must fix is
// noise to whoever reads the output. docs/checks.md explains the choices; the checks
// that need every file at once are in .fallowrc.jsonc.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "promise"],
  // The project's own rules, for the mistakes a Unity port makes.
  "jsPlugins": ["./tools/lint/synergy.ts"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    // On top of oxlint's correctness set: the conventions in AGENTS.md, and the JavaScript
    // behaviours that surprise someone coming from C#.
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/only-throw-error": "error",
    "typescript/require-array-sort-compare": "error",
    // A check that is silenced says why, or it is not silenced: `// @ts-expect-error <reason>`.
    // (oxlint-disable comments are held to the same by tools/lint/suppressions.test.ts.)
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true, "minimumDescriptionLength": 10 }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",

    "synergy/network-members": "error",
    "synergy/no-detached-method": "error",
    "synergy/no-discarded-result": "error",
    "synergy/no-engine-member": "error",
    "synergy/no-inline-remove": "error",
    "synergy/no-identity-compare": "error",
    "synergy/no-value-keys": "error",
    "synergy/no-unsent-message": "error",
    "synergy/no-skipped-test": "error",
    "synergy/test-needs-expect": "error",

    // Off, each for a reason:
    // reports this.invoke(this.tick, 1), the engine's own API; no-detached-method covers the real mistake
    "typescript/unbound-method": "off",
    // reports `await expect(promise).rejects...`, which bun:test types as not a promise
    "typescript/await-thenable": "off",
    // reports `${vector}`, though the value types print themselves; no-base-to-string still catches [object Object]
    "typescript/restrict-template-expressions": "off",
    // `let node = this` is how the engine walks up a hierarchy
    "typescript/no-this-alias": "off",
    // `for (const x of [...set])` copies on purpose: the loop body changes the set
    "unicorn/no-useless-spread": "off",
    // knows refs only from `react`'s useRef; the HUD's come from `preact/hooks`, so every
    // `ref.current = ...` is reported as changing a hook's return value
    "react/immutability": "off"
  },
  "overrides": [
    // Game scripts: one per file, named after the class.
    {
      "files": ["game/src/**"],
      "rules": {
        "synergy/behaviour-file-name": "error"
      }
    },
    // Game rules run on every machine and must give the same answer on each.
    {
      "files": ["game/src/rules/**", "game/src/**/rules.ts", "game/src/**/rules/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@synergy/engine",
                "message": "Game rules are pure. Import from @synergy/engine/math, /grid or /data: the main entry brings the scene and PlayCanvas with it."
              },
              {
                "name": "@synergy/netcode",
                "message": "Game rules are pure: no networking in them. Rules decide; a NetworkBehaviour or a command session carries the result."
              },
              { "name": "playcanvas", "message": "Game rules are pure: no rendering in them." },
              { "name": "preact", "message": "Game rules are pure: no UI in them." },
              { "name": "preact/hooks", "message": "Game rules are pure: no UI in them." }
            ]
          }
        ],
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Game rules are deterministic, so every machine gets the same result. Use new Random(state.seed) from @synergy/engine/math and store random.state back."
          },
          {
            "property": "localeCompare",
            "message": "Game rules are deterministic: the order depends on each player's language settings. Compare with < and >, or by a number."
          },
          {
            "property": "toLocaleString",
            "message": "Game rules are deterministic: the text depends on each player's language settings. Format in the view, not in the rules."
          },
          {
            "property": "toLocaleLowerCase",
            "message": "Game rules are deterministic: the result depends on each player's language settings. Use toLowerCase()."
          },
          {
            "property": "toLocaleUpperCase",
            "message": "Game rules are deterministic: the result depends on each player's language settings. Use toUpperCase()."
          }
        ],
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "Game rules are deterministic: the clock differs between machines. Pass time in as part of the command or the state."
          },
          {
            "name": "performance",
            "message": "Game rules are deterministic: the clock differs between machines. Pass time in as part of the command or the state."
          },
          {
            "name": "crypto",
            "message": "Game rules are deterministic, so every machine gets the same result. Use new Random(state.seed) from @synergy/engine/math and store random.state back."
          },
          {
            "name": "Intl",
            "message": "Game rules are deterministic: Intl reads each player's language settings. Format and sort by language in the view, not in the rules."
          },
          {
            "name": "globalThis",
            "message": "Game rules are pure: no globals. (globalThis.Math.random() and globalThis.Date are the same clock and dice as without it.)"
          },
          { "name": "window", "message": "Game rules are pure: they run in tests and on servers, where there is no window." },
          { "name": "document", "message": "Game rules are pure: they run in tests and on servers, where there is no document." },
          { "name": "localStorage", "message": "Game rules are pure: no storage. Save from the view (the save-load skill)." },
          { "name": "navigator", "message": "Game rules are pure: nothing that differs from one machine to the next." }
        ],
        "synergy/no-module-state": "error"
      }
    },
    // The packages are where the engine's own members are declared.
    {
      "files": ["packages/**"],
      "rules": {
        "synergy/no-engine-member": "off"
      }
    }
  ],
  "ignorePatterns": ["convex/_generated/**", "dist/**", "desktop/**", ".claude/worktrees/**"]
}
