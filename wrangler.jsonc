{
  // Cloudflare Worker that serves the built game from dist/ to the people allowed to see it.
  // See docs/deploying.md. `bun run rename <name>` changes "name" and both bucket names together.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synergy-game",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // Unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // Send every request through the Worker first, so nothing is served before the password check.
    "run_worker_first": true
  },
  // No usage reports from wrangler to Cloudflare for this project.
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": true,
  // Production settings. Flip to "true" when the game should be open to everyone.
  "vars": {
    "PUBLIC_ACCESS": "false"
  },
  // Where deploys keep images, models and sounds (the files in dist/assets/, named by a
  // hash of their content). `bun run deploy` and `preview:deploy` create the bucket and
  // upload only what it does not hold yet; the Worker serves /assets/ from it. Keep the
  // name "<worker name>-assets". To deploy without R2, delete both "r2_buckets" entries.
  "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "synergy-game-assets" }],
  // Settings for `wrangler preview` (per-branch and per-pull-request links). Previews do not
  // inherit the production vars, secrets or bindings above. With no PUBLIC_ACCESS they stay
  // locked to everyone but the people Cloudflare Access admits (PREVIEW_ALLOWED_EMAILS; the
  // deploy script passes ACCESS_AUD once Access is in place) and those who know a
  // PREVIEW_PASSWORD secret, if one is set for them.
  "previews": {
    // The same bucket on purpose: a hashed file is the same file for every build.
    "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "synergy-game-assets" }]
  }
}
